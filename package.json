    "build:linux": "node src/build.cjs --linux",
    "build:installer": "node src/build-installer.cjs"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "electron": "44.5.1"
  }
