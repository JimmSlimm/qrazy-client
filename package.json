{
  "name": "qrazy-client",
  "version": "0.3.10",
  "private": true,
  "description": "Windows and Linux desktop client for Qrazy",
  "main": "src/main.cjs",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node src/native/build.cjs",
    "prestart": "node src/native/build.cjs",
